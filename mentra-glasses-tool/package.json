{
  "name": "mentra-glasses-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local recorder for Mentra Live glasses: photos, video, events and (when available) IMU samples.",
  "engines": { "node": ">=20.12" },
  "scripts": {
    "start": "node src/server.mjs",
    "demo": "node src/demo.mjs",
    "receive": "node src/receiver.mjs",
    "video": "bash scripts/record-video.sh",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@mentra/sdk": "2.1.29"
  }
}
